{
  "description": "plugin-flutter guardrails: per-agent scope guard and Dart auto-format. The guards common to every project (destructive commands, secrets, sensitive files, checkpoint) are plugin-orchestrator's.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/agent-scope-guard.sh"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/format-dart.sh"],
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
